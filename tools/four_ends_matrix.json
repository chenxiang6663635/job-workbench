    "ends": {
      "cli": "命令行 tools/jobws.py",
      "mcp": "AI 宿主侧 MCP 服务 mcp/jobws_mcp",
      "plugin": "宿主插件 commands/ 与 agents/",
      "gui": "桌面端 web/backend/routers + 前端页面"
