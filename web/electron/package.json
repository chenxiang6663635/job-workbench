{
  "name": "job-workbench",
  "version": "0.1.1",
  "description": "求职工作台桌面端",
  "main": "main.js",
  "author": "job-workbench contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jobworkbench.app",
    "productName": "求职工作台",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/job-workbench-backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    }
  }
}
