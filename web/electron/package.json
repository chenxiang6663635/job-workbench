{
  "name": "job-workbench",
  "version": "0.3.0",
  "description": "Job Workbench desktop app — local-first job application tracker",
  "main": "main.js",
  "author": "job-workbench contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jobworkbench.app",
    "directories": {
      "output": "release"
    },
    "productName": "求职工作台",
    "artifactName": "job-workbench-setup-${version}-win64.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "chenxiang6663635",
        "repo": "job-workbench"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "zoom.js",
      "i18n.js",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/job-workbench-backend",
        "to": "backend",
        "filter": ["**/*", "!personal/**", "!portable.txt"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
