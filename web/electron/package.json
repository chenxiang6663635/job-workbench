{
  "name": "job-workbench",
  "version": "0.2.1",
  "description": "求职工作台桌面端",
  "main": "main.js",
  "author": "job-workbench contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jobworkbench.app",
    "directories": {
      "output": "release"
    },
    "productName": "求职工作台",
    "artifactName": "job-workbench-setup-${version}-win64.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "chenxiang6663635",
        "repo": "job-workbench"
      }
    ],
    "files": [
      "main.js",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/job-workbench-backend",
        "to": "backend",
        "filter": ["**/*", "!personal/**", "!portable.txt"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    }
  }
}
